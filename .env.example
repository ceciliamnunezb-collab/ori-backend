# Copiar este archivo como .env y completar. NUNCA commitear el .env.

# Conexión a PostgreSQL local (servicio postgresql-x64-18).
DATABASE_URL="postgresql://postgres:TU_CLAVE@localhost:5432/ori"

# Puerto de la API (por defecto 3000).
PORT=3000

# Cada cuántos minutos el reloj del sistema genera los recordatorios (RN-06). Por defecto 60.
RECORDATORIOS_INTERVALO_MIN=60
